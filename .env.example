# Copy to .env locally; never commit real keys. Existing environment values win.
# Stage 1 and --mode mock require no credentials.
# On api.deepseek.com, fallback is DEEPSEEK_API_KEY; never OPENAI_API_KEY.
# On other endpoints, fallback is OPENAI_API_KEY.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash
